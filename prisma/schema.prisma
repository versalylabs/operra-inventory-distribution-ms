generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  OWNER
  MANAGER
  WAREHOUSE_STAFF
  SALES_STAFF
  DELIVERY_STAFF
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum OrganizationStatus {
  ACTIVE
  TRIAL
  SUSPENDED
}

enum ProductStatus {
  ACTIVE
  DRAFT
  ARCHIVED
}

enum CategoryStatus {
  ACTIVE
  INACTIVE
}

enum WarehouseStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

enum StockMovementType {
  OPENING_BALANCE
  PURCHASE_RECEIPT
  SALE
  RETURN
  TRANSFER_OUT
  TRANSFER_IN
  ADJUSTMENT
  DAMAGE
  LOSS
}

enum AdjustmentReason {
  DAMAGED_GOODS
  LOST_GOODS
  EXPIRED_GOODS
  STOCK_COUNT_CORRECTION
  OPENING_BALANCE
  DATA_CORRECTION
}

enum AdjustmentStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum SupplierStatus {
  ACTIVE
  INACTIVE
}

enum PurchaseOrderStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum CustomerType {
  RETAIL
  WHOLESALE
  DISTRIBUTOR
  CORPORATE
  INDIVIDUAL
}

enum CustomerStatus {
  ACTIVE
  ON_HOLD
  INACTIVE
}

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  PROCESSING
  READY_FOR_DELIVERY
  PARTIALLY_DELIVERED
  DELIVERED
  CANCELLED
}

enum StockTransferStatus {
  DRAFT
  REQUESTED
  APPROVED
  DISPATCHED
  IN_TRANSIT
  RECEIVED
  CANCELLED
}

enum VehicleStatus {
  AVAILABLE
  ON_ROUTE
  MAINTENANCE
  INACTIVE
}

enum DriverStatus {
  AVAILABLE
  ON_DELIVERY
  OFF_DUTY
  SUSPENDED
}

enum DeliveryStatus {
  PENDING
  ASSIGNED
  DISPATCHED
  IN_TRANSIT
  DELIVERED
  FAILED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  MPESA
  BANK_TRANSFER
  CASH
  CHEQUE
  CARD
  OTHER
}

enum ExpenseCategory {
  TRANSPORT
  FUEL
  WAREHOUSE
  PACKAGING
  REPAIRS
  UTILITIES
  STAFF
  MISCELLANEOUS
}

model Organization {
  id                  String             @id @default(cuid())
  name                String
  slug                String             @unique
  logoUrl             String?
  email               String?
  phone               String?
  address             String?
  city                String?
  country             String             @default("Kenya")
  taxNumber           String?
  currency            String             @default("KES")
  timezone            String             @default("Africa/Nairobi")
  status              OrganizationStatus @default(ACTIVE)
  
  // Inventory & Document Settings
  allowNegativeStock  Boolean            @default(false)
  valuationMethod     String             @default("AVERAGE_COST")
  invoicePrefix       String             @default("INV-")
  orderPrefix         String             @default("ORD-")
  purchasePrefix      String             @default("PO-")
  deliveryPrefix      String             @default("DEL-")
  transferPrefix      String             @default("TRF-")
  defaultPaymentTerms Int                @default(30)
  defaultTaxRate      Decimal            @default(16.00) @db.Decimal(5, 2)

  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  // Relations
  memberships         OrganizationMember[]
  auditLogs           AuditLog[]
  notifications       Notification[]
  categories          Category[]
  products            Product[]
  warehouses          Warehouse[]
  inventoryItems      InventoryItem[]
  stockMovements      StockMovement[]
  stockAdjustments    StockAdjustment[]
  stockTransfers      StockTransfer[]
  suppliers           Supplier[]
  purchaseOrders      PurchaseOrder[]
  goodsReceipts       GoodsReceipt[]
  customers           Customer[]
  salesOrders         SalesOrder[]
  vehicles            Vehicle[]
  drivers             Driver[]
  deliveries          Delivery[]
  proofsOfDelivery    ProofOfDelivery[]
  invoices            Invoice[]
  payments            Payment[]
  expenses            Expense[]

  @@index([slug])
}

model User {
  id                  String             @id @default(cuid())
  name                String
  email               String             @unique
  passwordHash        String
  phone               String?
  avatarUrl           String?
  isSuperAdmin        Boolean            @default(false)
  status              UserStatus         @default(ACTIVE)
  lastLoginAt         DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  // Relations
  memberships         OrganizationMember[]
  sessions            Session[]
  auditLogs           AuditLog[]
  notifications       Notification[]
  managedWarehouses   Warehouse[]        @relation("WarehouseManager")
  stockMovements      StockMovement[]
  createdAdjustments  StockAdjustment[]  @relation("AdjustmentCreator")
  approvedAdjustments StockAdjustment[]  @relation("AdjustmentApprover")
  requestedTransfers  StockTransfer[]    @relation("TransferRequester")
  approvedTransfers   StockTransfer[]    @relation("TransferApprover")
  dispatchedTransfers StockTransfer[]    @relation("TransferDispatcher")
  receivedTransfers   StockTransfer[]    @relation("TransferReceiver")
  createdPOs          PurchaseOrder[]    @relation("POCreator")
  approvedPOs         PurchaseOrder[]    @relation("POApprover")
  goodsReceipts       GoodsReceipt[]     @relation("GRNReceiver")
  assignedCustomers   Customer[]         @relation("CustomerSalesRep")
  salesOrders         SalesOrder[]       @relation("OrderSalesPerson")
  driverProfiles      Driver[]           @relation("DriverUserAccount")
  createdDeliveries   Delivery[]         @relation("DeliveryCreator")
  capturedPODs        ProofOfDelivery[]  @relation("PODCapturer")
  issuedInvoices      Invoice[]          @relation("InvoiceIssuer")
  recordedPayments    Payment[]          @relation("PaymentRecorder")
  recordedExpenses    Expense[]          @relation("ExpenseRecorder")

  @@index([email])
}

model OrganizationMember {
  id                  String             @id @default(cuid())
  organizationId      String
  userId              String
  role                UserRole           @default(SALES_STAFF)
  title               String?
  isActive            Boolean            @default(true)
  joinedAt            DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  organization        Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
}

model Session {
  id                  String             @id @default(cuid())
  token               String             @unique
  userId              String
  activeOrgId         String?
  userAgent           String?
  ipAddress           String?
  expiresAt           DateTime
  createdAt           DateTime           @default(now())

  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

model Category {
  id                  String             @id @default(cuid())
  organizationId      String
  name                String
  slug                String
  description         String?
  parentId            String?
  status              CategoryStatus     @default(ACTIVE)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  organization        Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent              Category?          @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children            Category[]         @relation("CategoryHierarchy")
  products            Product[]

  @@unique([organizationId, slug])
  @@index([organizationId, status])
  @@index([parentId])
}

model Product {
  id                  String              @id @default(cuid())
  organizationId      String
  categoryId          String?
  name                String
  sku                 String
  barcode             String?
  description         String?
  brand               String?
  unitOfMeasure       String              @default("Unit")
  costPrice           Decimal             @default(0.00) @db.Decimal(12, 2)
  sellingPrice        Decimal             @default(0.00) @db.Decimal(12, 2)
  wholesalePrice      Decimal?            @db.Decimal(12, 2)
  taxRate             Decimal             @default(16.00) @db.Decimal(5, 2)
  minStockLevel       Int                 @default(10)
  reorderLevel        Int                 @default(25)
  maxStockLevel       Int?
  imageUrl            String?
  preferredSupplier   String?
  status              ProductStatus       @default(ACTIVE)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  organization        Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category            Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  inventoryItems      InventoryItem[]
  stockMovements      StockMovement[]
  stockAdjustments    StockAdjustment[]
  stockTransferItems  StockTransferItem[]
  purchaseOrderItems  PurchaseOrderItem[]
  goodsReceiptItems   GoodsReceiptItem[]
  salesOrderItems     SalesOrderItem[]
  deliveryItems       DeliveryItem[]
  invoiceItems        InvoiceItem[]

  @@unique([organizationId, sku])
  @@index([organizationId, status])
  @@index([organizationId, categoryId])
  @@index([organizationId, barcode])
}

model Warehouse {
  id                  String             @id @default(cuid())
  organizationId      String
  name                String
  code                String
  location            String
  address             String?
  phone               String?
  email               String?
  managerId           String?
  isDefault           Boolean            @default(false)
  status              WarehouseStatus    @default(ACTIVE)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  organization        Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  manager             User?              @relation("WarehouseManager", fields: [managerId], references: [id], onDelete: SetNull)
  inventoryItems      InventoryItem[]
  stockMovements      StockMovement[]
  stockAdjustments    StockAdjustment[]
  outgoingTransfers   StockTransfer[]    @relation("TransferSourceWarehouse")
  incomingTransfers   StockTransfer[]    @relation("TransferDestinationWarehouse")
  purchaseOrders      PurchaseOrder[]
  goodsReceipts       GoodsReceipt[]
  salesOrders         SalesOrder[]
  assignedVehicles    Vehicle[]
  deliveries          Delivery[]
  expenses            Expense[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
}

model InventoryItem {
  id                  String             @id @default(cuid())
  organizationId      String
  productId           String
  warehouseId         String
  currentStock        Int                @default(0)
  reservedStock       Int                @default(0)
  incomingStock       Int                @default(0)
  damagedStock        Int                @default(0)
  updatedAt           DateTime           @updatedAt

  organization        Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product             Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse           Warehouse          @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([productId, warehouseId])
  @@index([organizationId, warehouseId])
  @@index([organizationId, productId])
}

model StockMovement {
  id                  String             @id @default(cuid())
  organizationId      String
  productId           String
  warehouseId         String
  movementType        StockMovementType
  quantity            Int
  previousQuantity    Int
  newQuantity         Int
  reference           String?
  notes               String?
  userId              String?
  createdAt           DateTime           @default(now())

  organization        Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product             Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse           Warehouse          @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  user                User?              @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([organizationId, warehouseId, createdAt])
  @@index([organizationId, productId, createdAt])
}

model StockAdjustment {
  id                  String             @id @default(cuid())
  organizationId      String
  adjustmentNumber    String
  productId           String
  warehouseId         String
  quantityDelta       Int
  previousQuantity    Int
  newQuantity         Int
  reason              AdjustmentReason
  status              AdjustmentStatus   @default(APPROVED)
  notes               String?
  createdById         String
  approvedById        String?
  approvedAt          DateTime?
  createdAt           DateTime           @default(now())

  organization        Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product             Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse           Warehouse          @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  createdBy           User               @relation("AdjustmentCreator", fields: [createdById], references: [id], onDelete: Cascade)
  approvedBy          User?              @relation("AdjustmentApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  @@unique([organizationId, adjustmentNumber])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, warehouseId])
}

model StockTransfer {
  id                     String              @id @default(cuid())
  organizationId         String
  transferNumber         String
  sourceWarehouseId      String
  destinationWarehouseId String
  status                 StockTransferStatus @default(REQUESTED)
  driverName             String?
  vehicleRef             String?
  notes                  String?
  requestedById          String
  approvedById           String?
  dispatchedById         String?
  receivedById           String?
  approvedAt             DateTime?
  dispatchedAt           DateTime?
  receivedAt             DateTime?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  organization           Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sourceWarehouse        Warehouse           @relation("TransferSourceWarehouse", fields: [sourceWarehouseId], references: [id], onDelete: Restrict)
  destinationWarehouse   Warehouse           @relation("TransferDestinationWarehouse", fields: [destinationWarehouseId], references: [id], onDelete: Restrict)
  requestedBy            User                @relation("TransferRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  approvedBy             User?               @relation("TransferApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  dispatchedBy           User?               @relation("TransferDispatcher", fields: [dispatchedById], references: [id], onDelete: SetNull)
  receivedBy             User?               @relation("TransferReceiver", fields: [receivedById], references: [id], onDelete: SetNull)
  items                  StockTransferItem[]

  @@unique([organizationId, transferNumber])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, sourceWarehouseId])
  @@index([organizationId, destinationWarehouseId])
}

model StockTransferItem {
  id                  String        @id @default(cuid())
  stockTransferId     String
  productId           String
  requestedQuantity   Int
  dispatchedQuantity  Int           @default(0)
  receivedQuantity    Int           @default(0)
  damagedQuantity     Int           @default(0)
  unitCost            Decimal       @db.Decimal(12, 2)

  stockTransfer       StockTransfer @relation(fields: [stockTransferId], references: [id], onDelete: Cascade)
  product             Product       @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([stockTransferId])
  @@index([productId])
}

model Supplier {
  id                  String             @id @default(cuid())
  organizationId      String
  code                String
  companyName         String
  contactPerson       String?
  phone               String?
  email               String?
  address             String?
  city                String?
  taxNumber           String?
  paymentTermsDays    Int                @default(30)
  creditLimit         Decimal            @default(0.00) @db.Decimal(14, 2)
  bankDetails         String?
  suppliedCategories  String?
  totalPurchases      Decimal            @default(0.00) @db.Decimal(14, 2)
  outstandingBalance  Decimal            @default(0.00) @db.Decimal(14, 2)
  status              SupplierStatus     @default(ACTIVE)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  organization        Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchaseOrders      PurchaseOrder[]
  goodsReceipts       GoodsReceipt[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
}

model PurchaseOrder {
  id                  String              @id @default(cuid())
  organizationId      String
  poNumber            String
  supplierId          String
  warehouseId         String
  status              PurchaseOrderStatus @default(DRAFT)
  subtotal            Decimal             @default(0.00) @db.Decimal(14, 2)
  discountAmount      Decimal             @default(0.00) @db.Decimal(14, 2)
  taxAmount           Decimal             @default(0.00) @db.Decimal(14, 2)
  totalAmount         Decimal             @default(0.00) @db.Decimal(14, 2)
  expectedDeliveryAt  DateTime?
  notes               String?
  createdById         String
  approvedById        String?
  approvedAt          DateTime?
  orderedAt           DateTime?
  receivedAt          DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  organization        Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier            Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  warehouse           Warehouse           @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  createdBy           User                @relation("POCreator", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy          User?               @relation("POApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  items               PurchaseOrderItem[]
  goodsReceipts       GoodsReceipt[]

  @@unique([organizationId, poNumber])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, supplierId])
}

model PurchaseOrderItem {
  id                  String        @id @default(cuid())
  purchaseOrderId     String
  productId           String
  orderedQuantity     Int
  receivedQuantity    Int           @default(0)
  damagedQuantity     Int           @default(0)
  unitCost            Decimal       @db.Decimal(12, 2)
  taxRate             Decimal       @default(16.00) @db.Decimal(5, 2)
  lineTotal           Decimal       @db.Decimal(14, 2)

  purchaseOrder       PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product             Product       @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([purchaseOrderId])
  @@index([productId])
}

model GoodsReceipt {
  id                  String             @id @default(cuid())
  organizationId      String
  grnNumber           String
  purchaseOrderId     String
  supplierId          String
  warehouseId         String
  receivedById        String
  deliveryNoteRef     String?
  notes               String?
  totalAcceptedValue  Decimal            @default(0.00) @db.Decimal(14, 2)
  receivedAt          DateTime           @default(now())

  organization        Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchaseOrder       PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  supplier            Supplier           @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  warehouse           Warehouse          @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  receivedBy          User               @relation("GRNReceiver", fields: [receivedById], references: [id], onDelete: Restrict)
  items               GoodsReceiptItem[]

  @@unique([organizationId, grnNumber])
  @@index([organizationId, receivedAt])
  @@index([purchaseOrderId])
}

model GoodsReceiptItem {
  id                  String       @id @default(cuid())
  goodsReceiptId      String
  productId           String
  orderedQuantity     Int
  receivedQuantity    Int          // Actual good units placed into stock
  damagedQuantity     Int          @default(0)
  missingQuantity     Int          @default(0)
  unitCost            Decimal      @db.Decimal(12, 2)

  goodsReceipt        GoodsReceipt @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  product             Product      @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([goodsReceiptId])
  @@index([productId])
}

model Customer {
  id                  String         @id @default(cuid())
  organizationId      String
  code                String
  businessName        String
  contactPerson       String?
  phone               String?
  email               String?
  address             String?
  city                String?
  deliveryAddress     String?
  customerType        CustomerType   @default(WHOLESALE)
  taxNumber           String?
  paymentTermsDays    Int            @default(14)
  creditLimit         Decimal        @default(0.00) @db.Decimal(14, 2)
  totalPurchases      Decimal        @default(0.00) @db.Decimal(14, 2)
  outstandingBalance  Decimal        @default(0.00) @db.Decimal(14, 2)
  salesRepId          String?
  status              CustomerStatus @default(ACTIVE)
  notes               String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  organization        Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  salesRep            User?          @relation("CustomerSalesRep", fields: [salesRepId], references: [id], onDelete: SetNull)
  salesOrders         SalesOrder[]
  deliveries          Delivery[]
  invoices            Invoice[]
  payments            Payment[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([organizationId, customerType])
}

model SalesOrder {
  id                  String           @id @default(cuid())
  organizationId      String
  orderNumber         String
  customerId          String
  warehouseId         String
  salesPersonId       String
  status              SalesOrderStatus @default(DRAFT)
  subtotal            Decimal          @default(0.00) @db.Decimal(14, 2)
  discountAmount      Decimal          @default(0.00) @db.Decimal(14, 2)
  taxAmount           Decimal          @default(0.00) @db.Decimal(14, 2)
  totalAmount         Decimal          @default(0.00) @db.Decimal(14, 2)
  deliveryAddress     String?
  expectedDeliveryAt  DateTime?
  notes               String?
  stockReserved       Boolean          @default(false)
  confirmedAt         DateTime?
  deliveredAt         DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  organization        Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer            Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  warehouse           Warehouse        @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  salesPerson         User             @relation("OrderSalesPerson", fields: [salesPersonId], references: [id], onDelete: Restrict)
  items               SalesOrderItem[]
  deliveries          Delivery[]
  invoices            Invoice[]

  @@unique([organizationId, orderNumber])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, customerId])
  @@index([organizationId, warehouseId])
}

model SalesOrderItem {
  id                  String     @id @default(cuid())
  salesOrderId        String
  productId           String
  orderedQuantity     Int
  deliveredQuantity   Int        @default(0)
  unitPrice           Decimal    @db.Decimal(12, 2)
  discountAmount      Decimal    @default(0.00) @db.Decimal(12, 2)
  taxRate             Decimal    @default(16.00) @db.Decimal(5, 2)
  lineTotal           Decimal    @db.Decimal(14, 2)

  salesOrder          SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  product             Product    @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([salesOrderId])
  @@index([productId])
}

model Vehicle {
  id                  String        @id @default(cuid())
  organizationId      String
  registrationNumber  String
  makeModel           String
  vehicleType         String        @default("Box Truck")
  capacityKg          Int           @default(3500)
  assignedDepotId     String?
  insuranceExpiry     DateTime?
  inspectionExpiry    DateTime?
  status              VehicleStatus @default(AVAILABLE)
  notes               String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  organization        Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedDepot       Warehouse?    @relation(fields: [assignedDepotId], references: [id], onDelete: SetNull)
  defaultDrivers      Driver[]      @relation("DriverDefaultVehicle")
  deliveries          Delivery[]

  @@unique([organizationId, registrationNumber])
  @@index([organizationId, status])
}

model Driver {
  id                  String       @id @default(cuid())
  organizationId      String
  code                String
  userId              String?
  fullName            String
  phone               String
  email               String?
  licenseNumber       String
  licenseClass        String       @default("BCE")
  licenseExpiry       DateTime?
  defaultVehicleId    String?
  status              DriverStatus @default(AVAILABLE)
  completedDeliveries Int          @default(0)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                User?        @relation("DriverUserAccount", fields: [userId], references: [id], onDelete: SetNull)
  defaultVehicle      Vehicle?     @relation("DriverDefaultVehicle", fields: [defaultVehicleId], references: [id], onDelete: SetNull)
  deliveries          Delivery[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
}

model Delivery {
  id                  String          @id @default(cuid())
  organizationId      String
  deliveryNumber      String
  salesOrderId        String
  customerId          String
  warehouseId         String
  driverId            String?
  vehicleId           String?
  deliveryAddress     String
  scheduledDate       DateTime        @default(now())
  status              DeliveryStatus  @default(PENDING)
  dispatchNotes       String?
  failureReason       String?
  dispatchedAt        DateTime?
  deliveredAt         DateTime?
  createdById         String
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  organization        Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  salesOrder          SalesOrder      @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)
  customer            Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  warehouse           Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  driver              Driver?         @relation(fields: [driverId], references: [id], onDelete: SetNull)
  vehicle             Vehicle?        @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  createdBy           User            @relation("DeliveryCreator", fields: [createdById], references: [id], onDelete: Restrict)
  items               DeliveryItem[]
  proofOfDelivery     ProofOfDelivery?

  @@unique([organizationId, deliveryNumber])
  @@index([organizationId, status, scheduledDate])
  @@index([salesOrderId])
  @@index([driverId])
}

model DeliveryItem {
  id                  String   @id @default(cuid())
  deliveryId          String
  productId           String
  orderedQuantity     Int
  dispatchedQuantity  Int
  deliveredQuantity   Int      @default(0)
  returnedQuantity    Int      @default(0)
  conditionNotes      String?

  delivery            Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  product             Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([deliveryId])
  @@index([productId])
}

model ProofOfDelivery {
  id                  String       @id @default(cuid())
  organizationId      String
  deliveryId          String       @unique
  recipientName       String
  recipientRole       String?
  recipientPhone      String?
  signatureData       String
  deliveryPhotoUrl    String?
  gpsCoordinates      String?
  deliveryNotes       String?
  capturedById        String?
  capturedAt          DateTime     @default(now())

  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  delivery            Delivery     @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  capturedBy          User?        @relation("PODCapturer", fields: [capturedById], references: [id], onDelete: SetNull)

  @@index([organizationId, capturedAt])
}

model Invoice {
  id                  String        @id @default(cuid())
  organizationId      String
  invoiceNumber       String
  salesOrderId        String?
  customerId          String
  issuedById          String
  status              InvoiceStatus @default(ISSUED)
  issueDate           DateTime      @default(now())
  dueDate             DateTime
  subtotal            Decimal       @default(0.00) @db.Decimal(14, 2)
  discountAmount      Decimal       @default(0.00) @db.Decimal(14, 2)
  taxAmount           Decimal       @default(0.00) @db.Decimal(14, 2)
  totalAmount         Decimal       @default(0.00) @db.Decimal(14, 2)
  amountPaid          Decimal       @default(0.00) @db.Decimal(14, 2)
  balanceDue          Decimal       @default(0.00) @db.Decimal(14, 2)
  taxReference        String?
  notes               String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  organization        Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  salesOrder          SalesOrder?   @relation(fields: [salesOrderId], references: [id], onDelete: SetNull)
  customer            Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  issuedBy            User          @relation("InvoiceIssuer", fields: [issuedById], references: [id], onDelete: Restrict)
  items               InvoiceItem[]
  payments            Payment[]

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId, status, dueDate])
  @@index([organizationId, customerId])
  @@index([salesOrderId])
}

model InvoiceItem {
  id                  String   @id @default(cuid())
  invoiceId           String
  productId           String
  quantity            Int
  unitPrice           Decimal  @db.Decimal(12, 2)
  discountAmount      Decimal  @default(0.00) @db.Decimal(12, 2)
  taxRate             Decimal  @default(16.00) @db.Decimal(5, 2)
  lineTotal           Decimal  @db.Decimal(14, 2)

  invoice             Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product             Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([invoiceId])
  @@index([productId])
}

model Payment {
  id                  String        @id @default(cuid())
  organizationId      String
  paymentNumber       String
  invoiceId           String
  customerId          String
  recordedById        String
  amount              Decimal       @db.Decimal(14, 2)
  method              PaymentMethod @default(MPESA)
  reference           String?
  paymentDate         DateTime      @default(now())
  notes               String?
  createdAt           DateTime      @default(now())

  organization        Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice             Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  customer            Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  recordedBy          User          @relation("PaymentRecorder", fields: [recordedById], references: [id], onDelete: Restrict)

  @@unique([organizationId, paymentNumber])
  @@index([organizationId, paymentDate])
  @@index([invoiceId])
  @@index([customerId])
}

model Expense {
  id                  String          @id @default(cuid())
  organizationId      String
  expenseNumber       String
  category            ExpenseCategory @default(FUEL)
  amount              Decimal         @db.Decimal(14, 2)
  expenseDate         DateTime        @default(now())
  description         String
  paymentMethod       PaymentMethod   @default(MPESA)
  reference           String?
  warehouseId         String?
  recordedById        String
  notes               String?
  createdAt           DateTime        @default(now())

  organization        Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  warehouse           Warehouse?      @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  recordedBy          User            @relation("ExpenseRecorder", fields: [recordedById], references: [id], onDelete: Restrict)

  @@unique([organizationId, expenseNumber])
  @@index([organizationId, category, expenseDate])
}

model AuditLog {
  id                  String             @id @default(cuid())
  organizationId      String
  userId              String?
  action              String
  entity              String
  entityId            String?
  previousValue       Json?
  newValue            Json?
  ipAddress           String?
  createdAt           DateTime           @default(now())

  organization        Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                User?              @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([entity, entityId])
}

model Notification {
  id                  String             @id @default(cuid())
  organizationId      String
  userId              String?
  type                String
  title               String
  message             String
  link                String?
  isRead              Boolean            @default(false)
  createdAt           DateTime           @default(now())

  organization        Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                User?              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, isRead, createdAt])
  @@index([userId, isRead])
}
